{
  "apiVersion": 2,
  "id": "twitch-channel",
  "name": {
    "en": "Twitch channel",
    "fr": "Chaîne Twitch"
  },
  "version": "1.0.0",
  "description": {
    "en": "Tells the rest of the site when you are live and offers your latest clips. Discord announcements pick the live up; the maze overlay shows the clips.",
    "fr": "Indique au reste du site quand vous êtes en direct et propose vos derniers clips. Les annonces Discord reprennent le live ; l'overlay labyrinthe affiche les clips."
  },
  "author": "Vitrine",
  "license": "MIT",
  "icon": "🟣",
  "main": "index.mjs",
  "type": "utility",
  "instances": "single",
  "page": false,
  "provides": [
    {
      "topic": "stream.live",
      "label": {
        "en": "Current live stream",
        "fr": "Live en cours"
      }
    },
    {
      "topic": "maze.poster",
      "label": {
        "en": "Latest clips as posters",
        "fr": "Derniers clips en affiches"
      }
    }
  ],
  "permissions": [
    "topics"
  ],
  "settings": [
    {
      "key": "channel",
      "type": "text",
      "label": {
        "en": "Twitch channel (login)",
        "fr": "Chaîne Twitch (identifiant)"
      },
      "help": {
        "en": "For example mychannel",
        "fr": "Par exemple machaine"
      }
    },
    {
      "key": "clientId",
      "type": "text",
      "label": {
        "en": "Twitch client id",
        "fr": "Client id Twitch"
      },
      "help": {
        "en": "From dev.twitch.tv/console (an application of your own).",
        "fr": "Depuis dev.twitch.tv/console (une application à vous)."
      }
    },
    {
      "key": "clientSecret",
      "type": "secret",
      "label": {
        "en": "Twitch client secret",
        "fr": "Client secret Twitch"
      }
    }
  ]
}