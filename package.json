{
  "name": "vitrine",
  "version": "0.1.0",
  "private": true,
  "description": "Framework générique de site pour créateurs : collections, redirections, multilingue et modules installables.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bootstrap": "node scripts/bootstrap.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/register.mjs --test \"tests/**/*.test.mjs\"",
    "test:watch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/register.mjs --test --watch \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.29.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.8",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/client@6.19.3": true
  }
}
