npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (SQLite local)
prisma/data/

# journal du script de déploiement continu (scripts/auto-deploy.sh)
deploy.log

# scratch perso (maquettes, tests locaux) — jamais committé
/scratch/

# données métier (seed partenaires, exports) — sur le serveur, jamais dans git
/data/

# bases de données temporaires des tests
/tests/.tmp/

# bases SQLite et données d'exécution (sauvegardes, envois, clés générées)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal
/uploads/
