# dependencies
/node_modules

# next.js
/.next/
/out/

# instantané des modules (curiosa-extras), récupéré par `npm run extras:fetch` : jamais versionné ici
/extras/

# production
/build

# env et secrets : jamais dans git (seul .env.example, sans valeurs réelles, est suivi)
.env
.env.*
!.env.example
*.env
.envrc

