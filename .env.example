# ─── Obligatoire ──────────────────────────────────────────────────────────
# Base SQLite : un seul fichier, aucun service à lancer. Chemin relatif au
# dossier prisma/ ; en Docker on utilise un chemin absolu dans le volume.
DATABASE_URL="file:../data/curiosa.db"

# URL publique du site (sitemap, flux RSS, Open Graph).
SITE_URL="http://localhost:3000"

# ─── Facultatif ───────────────────────────────────────────────────────────
# Anciens noms de domaine (10 au plus, séparés par des virgules) : le site les redirige (301) vers SITE_URL. Voir docs/MIGRER-DOMAINE.md.
# LEGACY_HOSTS="ancien.example.org"

# Dossier des données de l'installation (envois, modules installés, secret
# de session). À sauvegarder avec la base. Défaut : ./data
# DATA_DIR="data"

# Secret de signature des sessions. Si absent, il est généré une fois et
# gardé dans data/auth-secret.
# AUTH_SECRET=""

# Si défini, l'assistant de première installation exige ce jeton : empêche un
# inconnu de réclamer un site fraîchement déployé sur Internet.
# SETUP_TOKEN=""

# Modules : hébergeurs git autorisés pour l'installation depuis l'admin
# ("*" = tous). Défaut : github.com,gitlab.com,codeberg.org,bitbucket.org
# MODULES_ALLOWED_HOSTS="github.com,gitlab.com"

# Catalogue de modules proposé dans l'admin (JSON public, voir docs/MODULES.md).
# MODULES_INDEX_URL="https://example.org/curiosa-modules.json"

# Catalogue : le cœur est installé SEUL, ses modules viennent du catalogue (index et suggestions lus à l'exécution dans un dépôt git).
# CURIOSA_CATALOGUE_REPO="https://github.com/helldog136/curiosa-extras"   # défaut : ce dépôt, le seul que le cœur connaît
# CURIOSA_CATALOGUE_REF="main"                                       # défaut : la branche par défaut

# Développement de modules uniquement : autorise file:// comme dépôt.
# CURIOSA_ALLOW_LOCAL_MODULES="1"

# Développement de modules uniquement : temps (en millisecondes, 100 à 120000) qu'un module a pour fabriquer un morceau de page publique avant d'être ignoré
# (voir docs/PLATFORM.md). Défaut : 8000. Inutile en production : ne le changez pas.
# CURIOSA_SECTION_TIMEOUT_MS="8000"

# ─── Mises à jour depuis l'admin (voir docs/INSTALL.md) ───────────────────
# Après une mise à jour réussie, comment redémarrer le serveur ? L'une des deux, ou aucune (redémarrage à la main).
# CURIOSA_RESTART_COMMAND="sudo systemctl restart curiosa"
# CURIOSA_SUPERVISED=1
# Adresse où le site répond en local, pour les mises à jour en plusieurs étapes (défaut : http://127.0.0.1:$PORT/)
# CURIOSA_READY_URL="http://127.0.0.1:3000/"
# Remote git qui sert de source des versions (défaut : origin).
# CURIOSA_UPDATE_REPO=propriétaire/dépôt   # dépôt des releases (défaut : celui de release.json)
# CURIOSA_TRUSTED_PROXIES=1               # nombre de reverse proxys devant le site (adresse du visiteur = entrée de X-Forwarded-For comptée depuis la fin)
# CURIOSA_UPDATE_REMOTE=origin             # clone git de développement : remote d'où lire le catalogue

# ─── Docker (docker-compose.yml) ──────────────────────────────────────────
# Docker Compose reads this file (copy it to `.env`) and fills the variables
# of docker-compose.yml. DATABASE_URL and DATA_DIR above are ignored by
# Docker: the compose file points them into the data volume by itself.
# Already used by Docker, set them in the sections above: SITE_URL (the public
# address, required for a real site), SETUP_TOKEN, AUTH_SECRET, LEGACY_HOSTS,
# CURIOSA_TRUSTED_PROXIES (default 1).
#
# Domain for automatic HTTPS. Required only with `docker compose --profile https up -d`.
# Its DNS must already point to this server, and ports 80 and 443 must be open.
# Set SITE_URL to the same address, with https://.
# CURIOSA_DOMAIN="example.org"
#
# Where the data lives (database, uploads, modules). Default: a Docker volume.
# A full path uses that folder on the host instead, easier to back up (NAS).
# CURIOSA_DATA_DIR="/volume1/docker/curiosa/data"
#
# Host port on which the app listens. Default 3000.
# CURIOSA_PORT="3000"
#
# Host address on which the app listens. Default 127.0.0.1 (this machine only):
# the right choice behind a proxy such as the bundled Caddy. Use 0.0.0.0 only
# for a quick public test without HTTPS.
# CURIOSA_BIND="127.0.0.1"
#
# Time zone of the container, for dates in logs and scheduled work. Default UTC.
# TZ="Europe/Paris"

# Traefik: only with the override file
#   docker compose -f docker-compose.yml -f docker-compose.traefik.yml up -d
# It uses CURIOSA_DOMAIN above and publishes no port on the host. Do not mix
# it with the bundled Caddy (`--profile https`).
# Docker network shared with your Traefik. Default traefik.
# TRAEFIK_NETWORK="traefik"
# Traefik entrypoint that serves HTTPS. Default websecure.
# TRAEFIK_ENTRYPOINT="websecure"
# Name of the certificate resolver defined in your Traefik. Default letsencrypt.
# TRAEFIK_CERTRESOLVER="letsencrypt"
