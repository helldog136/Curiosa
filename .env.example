# ─── Obligatoire ──────────────────────────────────────────────────────────
# Base SQLite : un seul fichier, aucun service à lancer. Chemin relatif au
# dossier prisma/ ; en Docker on utilise un chemin absolu dans le volume.
DATABASE_URL="file:../data/curiosa.db"

# URL publique du site (sitemap, flux RSS, Open Graph).
SITE_URL="http://localhost:3000"

# ─── Facultatif ───────────────────────────────────────────────────────────
# Dossier des données de l'installation (envois, modules installés, secret
# de session). À sauvegarder avec la base. Défaut : ./data
# DATA_DIR="data"

# Secret de signature des sessions. Si absent, il est généré une fois et
# gardé dans data/auth-secret.
# AUTH_SECRET=""

# Si défini, l'assistant de première installation exige ce jeton : empêche un
# inconnu de réclamer un site fraîchement déployé sur Internet.
# SETUP_TOKEN=""

# Modules : hébergeurs git autorisés pour l'installation depuis l'admin
# ("*" = tous). Défaut : github.com,gitlab.com,codeberg.org,bitbucket.org
# MODULES_ALLOWED_HOSTS="github.com,gitlab.com"

# Catalogue de modules proposé dans l'admin (JSON public, voir docs/MODULES.md).
# MODULES_INDEX_URL="https://example.org/curiosa-modules.json"

# Catalogue : la liste des modules reconnus est lue à l'exécution dans le dépôt du framework (catalogue/index.json).
# CURIOSA_CATALOGUE_REPO="https://github.com/owner/curiosa-extras"   # défaut : le dépôt de modules voisin du dépôt d'origine de l'installation
# CURIOSA_EXTRAS_DIR="/chemin/vers/extras"   # défaut : ./extras (modules livrés avec la version)
# CURIOSA_CATALOGUE_REF="main"                                       # défaut : la branche par défaut
# CURIOSA_CATALOGUE_RUNTIME="0"                                      # ne pas interroger : copie livrée avec la version

# Développement de modules uniquement : autorise file:// comme dépôt.
# CURIOSA_ALLOW_LOCAL_MODULES="1"

# ─── Mises à jour depuis l'admin (voir docs/INSTALL.md) ───────────────────
# Après une mise à jour réussie, comment redémarrer le serveur ? L'une des deux, ou aucune (redémarrage à la main).
# CURIOSA_RESTART_COMMAND="sudo systemctl restart curiosa"
# CURIOSA_SUPERVISED=1
# Remote git qui sert de source des versions (défaut : origin).
# CURIOSA_UPDATE_REPO=propriétaire/dépôt   # dépôt des releases (défaut : celui de release.json)
# CURIOSA_UPDATE_REMOTE=origin             # clone git de développement : remote d'où lire le catalogue
