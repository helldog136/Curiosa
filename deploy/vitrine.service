# Exemple d'unité systemd — à copier dans /etc/systemd/system/vitrine.service, puis :
#   sudo systemctl daemon-reload && sudo systemctl enable --now vitrine
#
# Adaptez User, WorkingDirectory et le chemin de node. Le point important pour les mises à jour depuis l'admin :
# `Restart=always` + VITRINE_SUPERVISED=1 → après une mise à jour, le serveur s'arrête et systemd le relance sur la nouvelle version.
[Unit]
Description=Site (Vitrine)
After=network.target

[Service]
Type=simple
User=vitrine
WorkingDirectory=/srv/vitrine
EnvironmentFile=/srv/vitrine/.env
Environment=NODE_ENV=production
Environment=VITRINE_SUPERVISED=1
ExecStart=/usr/bin/npx next start -p 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
