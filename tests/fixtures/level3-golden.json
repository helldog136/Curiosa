   "action": "core_update",
   "audit": "0.46.1>0.47.0",
   "en": "Update Curiosa from version 0.46.1 to version 0.47.0.",
   "fr": "Mettre Curiosa à jour de la version 0.46.1 vers la version 0.47.0."
  },
  {
   "action": "module_update",
   "audit": "etoile-nord",
   "en": "Update the module \"ETOILE-NORD\" from version 1.0.0 to version 1.1.0.",
   "fr": "Mettre à jour le module « ETOILE-NORD » de la version 1.0.0 vers la version 1.1.0."
  },
  {
   "action": "modules_update_all",
   "audit": "etoile-nord 1.0.0>1.1.0, lune-douce 2.0.0>2.0.1",
   "en": "Update 2 modules: ETOILE-NORD (1.0.0 → 1.1.0), LUNE-DOUCE (2.0.0 → 2.0.1).",
   "fr": "Mettre à jour 2 modules : ETOILE-NORD (1.0.0 → 1.1.0), LUNE-DOUCE (2.0.0 → 2.0.1)."
  },
  {
   "action": "module_uninstall",
   "audit": "etoile-nord keepData",
   "en": "Uninstall the module \"ETOILE-NORD\", keeping its data aside (it comes back if the module is installed again).",
   "fr": "Désinstaller le module « ETOILE-NORD » en gardant ses données de côté (elles reviennent si le module est réinstallé)."
  },
  {
   "action": "module_uninstall",
   "audit": "etoile-nord erase",
   "en": "Uninstall the module \"ETOILE-NORD\" AND erase all its data.",
   "fr": "Désinstaller le module « ETOILE-NORD » ET effacer toutes ses données."
  },
  {
   "action": "module_install",
   "audit": "journal 1.2.0 key=journal-news + fournisseur, autre",
   "en": "Install the module \"Journal\" (version 1.2.0) and create its first instance. It comes with: Fournisseur, AUTRE.",
   "fr": "Installer le module « Journal » (version 1.2.0) et lui créer sa première instance. Il arrive avec : Fournisseur, AUTRE."
  },
  {
   "action": "module_install",
   "audit": "journal 1.2.0",
   "en": "Install the module \"Journal\" (version 1.2.0) and create its first instance.",
   "fr": "Installer le module « Journal » (version 1.2.0) et lui créer sa première instance."
  },
  {
   "action": "module_install",
   "audit": "journal 1.2.0, liens 0.3.0",
   "en": "Install 2 modules in one go. Read each one before approving. “JOURNAL” (version 1.2.0). “LIENS” (version 0.3.0). It comes with: JOURNAL.",
   "fr": "Installer 2 modules d'un coup. Lisez chacun avant d'approuver. « JOURNAL » (version 1.2.0). « LIENS » (version 0.3.0). Il arrive avec : JOURNAL."
  },
  {
   "action": "skin_install",
   "audit": "aurore 1.0.0",
   "en": "Install the “Aurore” skin (version 1.0.0). It will not be in use right away.",
   "fr": "Installer le skin « Aurore » (version 1.0.0). Il ne sera pas utilisé tout de suite."
  },
  {
   "action": "skin_activate",
   "audit": "aurore",
   "en": "Use the “Aurore” skin for your site. Your color adjustments are set aside: you will be able to undo in Appearance.",
   "fr": "Utiliser le skin « Aurore » pour votre site. Vos retouches de couleurs sont mises de côté : vous pourrez annuler dans Apparence."
  },
  {
   "action": "skin_remove",
   "audit": "aurore",
   "en": "Remove the “Aurore” skin. Your content does not change.",
   "fr": "Retirer le skin « Aurore ». Votre contenu ne change pas."
  },
  {
   "action": "font_set",
