 "LEVEL3_INPUT": {
  "core_update": {
   "type": "object"
  },
  "modules_update_all": {
   "type": "object"
  },
  "module_update": {
   "type": "object",
   "properties": {
    "module": {
     "type": "string",
     "maxLength": 64,
     "description": "Module identifier, as listed by maintenance_modules."
    }
   },
   "required": [
    "module"
   ]
  },
  "module_uninstall": {
   "type": "object",
   "properties": {
    "module": {
     "type": "string",
     "maxLength": 64,
     "description": "Module identifier, as listed by maintenance_modules."
    },
    "keepData": {
     "type": "boolean",
     "description": "true (default): the module's settings and data are kept aside, inert, and come back if the module is installed again. false: everything is erased for good (irreversible)."
    }
   },
   "required": [
    "module"
   ]
  },
  "module_install": {
   "type": "object",
   "properties": {
    "module": {
     "type": "string",
     "maxLength": 40,
     "description": "Module identifier from maintenance_catalog_list (for example blog). Use module OR modules."
    },
    "modules": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Several module identifiers (12 at most) asked in ONE request that the owner approves as a whole; plan them first with maintenance_catalog_plan. No instanceKey with a list."
    },
    "instanceKey": {
     "type": "string",
     "maxLength": 31,
     "description": "Optional, only for a module that allows several instances: the key of its first instance (lowercase letters, digits and dashes, for example blog-news). Default: derived from the module identifier."
    }
   }
  },
  "skin_install": {
   "type": "object",
   "properties": {
    "skin": {
     "type": "string",
     "maxLength": 41,
     "description": "Skin identifier, as listed by maintenance_skin_list (for example paper-ink). The basic skin is basic."
    }
   },
   "required": [
    "skin"
   ]
  },
  "skin_activate": {
   "type": "object",
   "properties": {
    "skin": {
     "type": "string",
     "maxLength": 41,
     "description": "Skin identifier, as listed by maintenance_skin_list (for example paper-ink). The basic skin is basic."
    }
   },
   "required": [
    "skin"
   ]
  },
  "skin_remove": {
   "type": "object",
   "properties": {
    "skin": {
     "type": "string",
     "maxLength": 41,
     "description": "Skin identifier, as listed by maintenance_skin_list (for example paper-ink). The basic skin is basic."
    }
   },
   "required": [
    "skin"
   ]
  },
  "skin_set_options": {
   "type": "object",
   "properties": {
    "mode": {
     "type": "string",
     "enum": [
      "light",
      "dark"
     ],
     "description": "Only for a skin that has both a light and a dark mode (see maintenance_skin_status > activeSkin.modes): which mode the colours are for. The other mode keeps its values."
    },
    "background": {
     "type": "string",
     "maxLength": 9,
     "description": "Page background as a hex colour (for example #1a2b3c), or an empty string to go back to the skin's own value. Omit to leave it unchanged."
    },
    "surface": {
     "type": "string",
     "maxLength": 9,
     "description": "Cards and panels as a hex colour (for example #1a2b3c), or an empty string to go back to the skin's own value. Omit to leave it unchanged."
    },
    "textColor": {
     "type": "string",
     "maxLength": 9,
     "description": "Text as a hex colour (for example #1a2b3c), or an empty string to go back to the skin's own value. Omit to leave it unchanged."
    },
    "accent": {
     "type": "string",
     "maxLength": 9,
     "description": "Main colour (links, buttons) as a hex colour (for example #1a2b3c), or an empty string to go back to the skin's own value. Omit to leave it unchanged."
    },
    "accent2": {
     "type": "string",
     "maxLength": 9,
     "description": "Second accent as a hex colour (for example #1a2b3c), or an empty string to go back to the skin's own value. Omit to leave it unchanged."
    },
    "fontTitles": {
     "type": "string",
     "maxLength": 60,
     "description": "Font of titles: \"skin\" or a value listed in maintenance_skin_status > fonts.available. Omit to leave it unchanged."
    },
    "fontText": {
     "type": "string",
     "maxLength": 60,
     "description": "Font of body text: same values as fontTitles. Omit to leave it unchanged."
    }
   }
  },
  "skin_customize": {
   "type": "object",
   "properties": {
    "values": {
     "type": "array",
     "maxItems": 24,
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "maxLength": 25,
        "description": "The setting id."
       },
       "value": {
        "type": "string",
        "maxLength": 40,
        "description": "The value, written as text: a swatch id or #rrggbb for a colour, a value id for a choice, true or false for a toggle, a number for a slider, a picture id or none for a picture."
       }
      },
      "required": [
       "id",
       "value"
      ]
     },
     "description": "Settings to change, as listed by maintenance_skin_status > activeSkin.customize. Only what is named changes. Nothing can be uploaded: a picture is one of the skin's own, by id."
    },
    "look": {
     "type": "string",
     "maxLength": 31,
     "description": "The id of a look offered by the skin: it sets several settings at once, then `values` apply on top."
    },
    "reset": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "maxItems": 24,
     "description": "Setting ids to put back to the skin's own value, or [\"all\"] for everything."
    }
   }
  },
  "font_set": {
   "type": "object",
   "properties": {
    "titles": {
     "type": "string",
     "maxLength": 60,
     "description": "Font of titles: \"skin\" (the skin's own), or a value listed in maintenance_skin_status > fonts.available (for example lib:lora, sys:serif). Omit to leave it unchanged."
    },
    "text": {
     "type": "string",
     "maxLength": 60,
     "description": "Font of body text: same values as titles. Omit to leave it unchanged."
    }
   }
  },
  "instance_add": {
   "type": "object",
   "properties": {
    "module": {
     "type": "string",
     "maxLength": 64,
     "description": "Identifier of an INSTALLED module that allows several instances, as listed by maintenance_modules (for example blog)."
    },
    "nickname": {
     "type": "string",
     "maxLength": 40,
     "description": "Short name that tells the new instance apart from the others of the same module (for example News). It also becomes the public name at the start."
    }
   },
   "required": [
    "module",
    "nickname"
   ]
  },
  "entry_publish": {
   "type": "object"
  },
  "entry_unpublish": {
   "type": "object"
  },
  "site_settings_set": {
   "type": "object"
  },
  "navigation_set": {
   "type": "object",
   "properties": {
    "entries": {
     "type": "array",
     "description": "The WHOLE menu, in display order (40 entries at most, submenus included; 40 per submenu; two levels). Start from what navigation_get returns. Each entry has ONE target: {\"page\": \"home\"} (a page of the site: home or privacy), {\"instance\": \"pages\"} (the page of a module instance, key from site_info), {\"instance\": \"pages\", \"entry\": \"<entry id>\"} (a published entry of that instance), {\"path\": \"/contact\"} (a page of this site, by its address), or {\"externalUrl\": \"https://example.org\"} (a page elsewhere, https only). A submenu has no target but a label and \"children\": [...]. \"label\" is {\"en\": \"Home\", \"fr\": \"Accueil\"} with EVERY language of the site: optional when the target has its own name (the entry keeps it), required for externalUrl and submenus. Nothing is saved if one entry is wrong; every problem is listed.",
     "items": {
      "type": "object"
     }
    }
   },
   "required": [
    "entries"
   ]
  },
  "home_sections_set": {
   "type": "object",
   "properties": {
    "sections": {
     "type": "array",
     "description": "The WHOLE home page, top to bottom (30 sections at most). Start from what home_sections_list returns. A section that stays: {\"id\": \"<its id>\"} alone. A new section of a module: {\"instance\": \"hero\", \"section\": \"hero\", \"options\": {...}, \"size\": \"full\"} (instance key and section id come from home_sections_list > canAdd). A new text block: {\"block\": {\"kind\": \"cta\", \"title\": {\"en\": \"...\", \"fr\": \"...\"}, \"text\": {...}, \"buttonLabel\": {...}, \"buttonUrl\": \"/contact\"}} with EVERY language of the site (kinds: media, tabs, stats, cta, video). \"size\" is small, medium, large or full; \"isolated\": true puts it alone on its line. Plain text only, no HTML. Nothing is saved if one section is wrong; every problem is listed.",
     "items": {
      "type": "object"
     }
    }
   },
   "required": [
    "sections"
   ]
  }
 },
